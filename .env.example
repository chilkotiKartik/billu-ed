# ---------- Required ----------
# Clerk (https://dashboard.clerk.com): create an app, copy the two keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app

# ---------- Account storage (recommended) ----------
# Without these, progress and saved sheets stay on the student's phone only.
# Run supabase/migrations/0001_init.sql first. Then choose ONE of the two options:
SUPABASE_URL=https://xxxx.supabase.co
#  A) direct: server holds the service-role key
SUPABASE_SERVICE_ROLE_KEY=
#  B) safer: deploy supabase/edcat-sheets.ts as an edge function with the same token as a secret
EDCAT_FN_TOKEN=

# ---------- Shared rate limiting (recommended on Vercel) ----------
# Free Upstash Redis (https://upstash.com): REST URL + token. Without it limits are per server instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------- Optional ----------
# Gemini fallback reader (free key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# YouTube Data API v3: lecture videos play inside the app
YOUTUBE_API_KEY=
