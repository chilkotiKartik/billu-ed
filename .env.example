# Gemini (optional fallback reader, free key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# YouTube Data API v3 (optional): lecture videos play inside the app. Key: console.cloud.google.com > APIs > YouTube Data API v3 > Credentials
